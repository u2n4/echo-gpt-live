# Copy to .env or bridge.env and fill in the values you need. Never commit .env.

# OpenAI API key (alternatively stored in ~/.config/acv/openai.key)
OPENAI_API_KEY=

# Bridge service flags and location settings (read by cmd/bridge and deploy/bridge.service)
BRIDGE_FLAGS=
BRIDGE_PLACE=
BRIDGE_LAT=
BRIDGE_LON=
BRIDGE_TIMEZONE=

# AWS Lambda environment variables (read by lambda/index.mjs and lambda/deploy.sh)
ACV_UBUNTU_URL=
ACV_SIGNING_KEY=
ACV_ENDPOINT_ID=
ACV_FRIENDLY_NAME=
ACV_DISPLAY_CATEGORIES=
ACV_ENDPOINT_HEALTH=

# Optional diagnostics and Pion logging
RTCDIAG_FLAGS=
RTCDIAG_TURN_PASS=
PION_LOG_WARN=
PION_LOG_INFO=
