# Copy to ~/echo-gpt-live/bridge.env (the unit reads it with EnvironmentFile). Everything that is
# personal lives here, so the repository and its defaults fit anyone.

# Flags for cmd/bridge; `bin/bridge -h` explains every one and the measurement behind its default.
BRIDGE_FLAGS=--video sendonly --video-fps 1 --idle-close 60s --hold-after-disconnect 20s --max-session 90m --max-live 10m --delegation client --daily-budget-usd 2.0 --tools --web-search=free --farewell-grace 2s

# Where the Echo is, said the way a person would say it. Add a Latin spelling of any name the
# voice model could mishear. Goes into the prompt; empty leaves the location out.
BRIDGE_PLACE="the neighbourhood, the city (City), the country"

# Coordinates for the weather tool. Both 0 turns the tool off.
BRIDGE_LAT=0.0
BRIDGE_LON=0.0

# IANA zone for "what time is it"; empty uses the host's zone.
BRIDGE_TIMEZONE=

# Pion logging (optional): PION_LOG_WARN=all  PION_LOG_INFO=srtp
